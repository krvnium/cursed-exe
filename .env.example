# Groq API credentials. Use GROQ_API_KEY for new setups.
GROQ_API_KEY=

# Backward-compatible name accepted by CURSED.EXE.
VISION_API_KEY=

# Optional OpenAI-compatible provider host. For Groq, use https://api.groq.com
VISION_API_ENDPOINT=https://api.groq.com

# Optional model override. The default is qwen/qwen3.8-27b.
VISION_MODEL_NAME=qwen/qwen3.8-27b
